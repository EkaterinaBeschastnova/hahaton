# Порт приложения на компьютере разработчика.
APP_PORT=8080

# Локальная SQLite хранится в постоянном Docker volume.
DATABASE_URL=sqlite+aiosqlite:////data/mydom.db

# Интеграция с MAX. Токен намеренно не указан.
MAX_API_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=

# Для локальной проверки интерфейса достаточно localhost.
# Для кнопки в MAX нужен публичный HTTPS-адрес, доступный с устройства пользователя.
MINI_APP_URL=http://localhost:8080

# Заменить на случайные значения при любом публичном развертывании.
WEBHOOK_SECRET=replace-with-a-random-secret
JWT_SECRET=replace-with-a-random-secret
